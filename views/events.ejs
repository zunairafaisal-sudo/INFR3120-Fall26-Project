<div class="container">
    <h1 class="dashboard-title">Campus Connect Events Dashboard</h1>


<table class = "events-table">
    <tr>
        <th>Event Name</th>
        <th>Description</th>
        <th>Date</th>
        <th>Time</th>
        <th>Location</th>
    </tr>

    <% events.forEach(event => { %>
        <tr>
            <td><%= event.name %></td>
            <td><%= event.description %></td>
            <td><%= event.date %></td>
            <td><%= event.time %></td>
            <td><%= event.location %></td>
        </tr>
    <% }) %>
</table>
</div>